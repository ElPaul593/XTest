# URLs de produccion del FRONTEND (Vercel). Vite las hornea en el build: tras
# cambiarlas hay que volver a desplegar. En Vercel define esta misma variable en
# Settings -> Environment Variables.
#
# Apunta a TU backend desplegado en Render. La API externa de asientos/PayPal
# (https://apiconsumidorac.vercel.app) NO se configura aqui: la consume el backend
# a traves de EXTERNAL_API_URL.
VITE_API_URL=https://xtest-12qn.onrender.com/api
