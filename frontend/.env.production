# URLs de produccion del FRONTEND.
# Apunta a TU backend desplegado en Render (no a la API demo externa).
# En Vercel define estas mismas variables en Settings -> Environment Variables.
# Reemplaza TU-BACKEND por el subdominio real que te de Render.
VITE_API_URL=https://TU-BACKEND.onrender.com/api
VITE_SEAT_API_URL=https://TU-BACKEND.onrender.com/api/asientos
