# Runtime
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database
MONGO_URI=mongodb://127.0.0.1:27017/busreservation
# Legacy name used only by maintenance scripts
MONGODB_URI=

# Authentication
JWT_SECRET=replace-with-a-long-random-secret

# Public API URL used by Swagger
API_URL=http://localhost:5000

# External seats and pricing API
EXTERNAL_API_URL=https://replace-with-external-api.example.com
EXTERNAL_SEAT_API=
PRICING_API=
SEAT_API_URL=

# Google server-side APIs
GOOGLE_PLACES_API_KEY=replace-with-google-places-key
GOOGLE_MAPS_SERVER_KEY=replace-with-google-maps-server-key

# Email / SMTP for ticket delivery
APP_NAME=BusReserva
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# Alternative SMTP names accepted by the service
SMTP_HOST=
SMTP_PORT=

# Optional seed values for local administrative scripts
ADMIN_CEDULA=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Admin
ADMIN_APELLIDO=Sistema
ADMIN_TELEFONO=0999999999
AGENTE_CEDULA=
AGENTE_PASSWORD=
AGENTE_NOMBRE=Agente
AGENTE_APELLIDO=Turismo
AGENTE_TELEFONO=0999999999
