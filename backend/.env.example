# MongoDB Connection String (NO subas credenciales reales)
# Atlas (SRV):     mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
# Atlas (directo): mongodb://<usuario>:<password>@<host1>:27017,<host2>:27017/<db>?ssl=true&replicaSet=<rs>&authSource=admin
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/BusReservation?retryWrites=true&w=majority

# Server Port (Render/host lo define automáticamente)
PORT=5000

# JWT Secret Key (usa una cadena larga y aleatoria; NO la real del repo)
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET

# API externa (asientos + pricing). Una sola URL base.
EXTERNAL_API_URL=https://tu-api-externa.example.com

# ---------------------------------------------------------------------------
# Host público del backend
# Se incrusta en el enlace de recuperación de contraseña que recibe el usuario:
#   {VERCEL_BACKEND_URL}/api/auth/reset-password/{token}
# Si no se define, se usa http://localhost:{PORT}, que NO sirve en producción
# porque el enlace se abre desde el cliente de correo del usuario.
# ---------------------------------------------------------------------------
VERCEL_BACKEND_URL=https://tu-backend.onrender.com

# Host público del frontend (para volver a la aplicación tras el reseteo).
FRONTEND_URL=https://tu-frontend.vercel.app

# ---------------------------------------------------------------------------
# Envío de correo
# Este backend NO envía correo por SMTP: delega el envío en la API consumidora,
# que es la que tiene las credenciales del proveedor. Ver
# src/services/mailerService.js
#
# Si MAIL_API_URL se deja vacío se reutiliza EXTERNAL_API_URL.
# Contrato esperado:  POST {MAIL_API_URL}{MAIL_API_PATH}
#                     body: { to, subject, html, text, from, appName, meta }
# ---------------------------------------------------------------------------
MAIL_API_URL=
MAIL_API_PATH=/api/mail/send
MAIL_API_KEY=
MAIL_API_TIMEOUT_MS=15000
MAIL_FROM=no-reply@tudominio.com

# Pon false para no intentar siquiera la API consumidora mientras no tenga el
# endpoint. Ahorra la espera del timeout en cada envío.
MAIL_API_ENABLED=true

# ---------------------------------------------------------------------------
# SMTP directo (transporte 2)
#
# Se usa si la API consumidora no responde. Es la forma más rápida de tener
# correo real funcionando sin depender de ese endpoint.
#
# Con Gmail: activa la verificación en dos pasos en tu cuenta y crea una
# "Contraseña de aplicación" (16 caracteres). La contraseña normal NO sirve.
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USER=tucorreo@gmail.com
#   EMAIL_PASS=xxxx xxxx xxxx xxxx
#
# Si se dejan vacías y NODE_ENV no es production, los correos se escriben en
# backend/tmp/correos/ y el enlace se imprime en la consola del servidor.
# ---------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# ---------------------------------------------------------------------------
# Verificación del correo electrónico
#
# REQUIRE_EMAIL_VERIFIED=false  → la cuenta se crea sin verificar, se envía el
#   correo y el usuario PUEDE entrar; el frontend le muestra el aviso.
# REQUIRE_EMAIL_VERIFIED=true   → sin confirmar el correo no se puede entrar.
#   Actívalo solo cuando el envío esté funcionando de forma estable, o dejarás
#   fuera a quien no reciba el mensaje.
# ---------------------------------------------------------------------------
REQUIRE_EMAIL_VERIFIED=false
EMAIL_VERIFY_TTL_MINUTES=1440
EMAIL_VERIFY_RESEND_SECONDS=60

# Nombre de la aplicación (asunto y cuerpo de los correos, página de reseteo).
APP_NAME=CulturalTrip

# Minutos de validez del enlace de recuperación de contraseña.
RESET_TOKEN_TTL_MINUTES=30

# ---------------------------------------------------------------------------
# Inicio de sesión con Google
#
# Se obtiene en Google Cloud Console > APIs y servicios > Credenciales >
# ID de cliente de OAuth 2.0 (tipo "Aplicación web").
#
# El CLIENT_ID es público por diseño (viaja en el HTML de cualquier web que use
# Google Sign-In) y el backend lo publica en GET /api/auth/google/config para que
# el frontend no tenga que duplicarlo.
#
# El CLIENT_SECRET **no lo usa este flujo**: la verificación del id_token se hace
# contra las claves públicas de Google. Se deja documentado por si más adelante se
# añade el flujo de código de autorización (server-side).
#
# IMPORTANTE: en la consola de Google, "Orígenes autorizados de JavaScript" debe
# incluir EXACTAMENTE el puerto donde corre el frontend (por defecto 3000, ver
# frontend/vite.config.js). Si no coincide, Google rechaza con "origin_mismatch".
#
# Si GOOGLE_CLIENT_ID se deja vacío, el botón de Google no aparece y el resto de
# la aplicación funciona igual.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Crear/promover un admin:
#   npm run seed:admin -- --cedula <cedula> --password <password>
