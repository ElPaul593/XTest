# ==========================================================================
# CulturalTrip · Backend — plantilla de configuración
# Copia este archivo a .env y rellena los valores. .env está en .gitignore.
# En Render estas variables se definen en el panel del servicio (Environment).
# ==========================================================================

# ---------- Base de datos ----------
# Atlas (SRV):     mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/BusReservation?retryWrites=true&w=majority

# ---------- Servidor ----------
PORT=5000
NODE_ENV=development

# Clave JWT (cadena larga y aleatoria; nunca la real del repo)
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET

# ---------- API externa de asientos y pagos (apiconsumidorac / seat-api) ----------
# Una sola URL base. Los caminos exactos viven en src/config/externalApis.js.
#   Producción:  https://apiconsumidorac.vercel.app
#   Local:       http://localhost:5008
# La instalación antigua de Render (apiconsumidorac.onrender.com) no tiene
# PayPal y el backend la ignora aunque se configure aquí.
EXTERNAL_API_URL=https://apiconsumidorac.vercel.app

# Token para las rutas /api/admin de la API externa (aprobar/rechazar pagos en
# revisión). Debe coincidir con ADMIN_TOKEN de la API externa. Opcional.
SEAT_API_ADMIN_TOKEN=

# Tiempos de espera (ms). PayPal puede tardar varios segundos más el arranque
# en frío de Vercel.
SEAT_API_TIMEOUT_MS=10000
PAGO_API_TIMEOUT_MS=30000

# Respaldos SOLO para cuando la API externa no responde.
DEFAULT_PRECIO_UNITARIO_USD=10
FALLBACK_TOTAL_ASIENTOS=40
FALLBACK_HOLD_TTL_MS=600000

# ---------- CORS ----------
# Orígenes permitidos separados por coma. Sin definir, se acepta cualquier
# origen (con aviso en consola). En producción conviene fijarlo.
CORS_ORIGINS=
FRONTEND_URL=https://tu-frontend.vercel.app

# Host público del backend: se incrusta en el enlace de recuperación de
# contraseña ({VERCEL_BACKEND_URL}/api/auth/reset-password/{token}).
VERCEL_BACKEND_URL=https://tu-backend.onrender.com

# ---------- Correo ----------
# Transporte 1: API consumidora (si MAIL_API_URL está vacío se usa EXTERNAL_API_URL)
MAIL_API_URL=
MAIL_API_PATH=/api/mail/send
MAIL_API_KEY=
MAIL_API_TIMEOUT_MS=15000
MAIL_FROM=no-reply@tudominio.com
MAIL_API_ENABLED=true

# Transporte 2: SMTP directo (Gmail: contraseña de aplicación de 16 caracteres)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# Verificación del correo electrónico
REQUIRE_EMAIL_VERIFIED=false
EMAIL_VERIFY_TTL_MINUTES=1440
EMAIL_VERIFY_RESEND_SECONDS=60

APP_NAME=CulturalTrip
RESET_TOKEN_TTL_MINUTES=30

# ---------- Inicio de sesión con Google ----------
# Google Cloud Console > Credenciales > ID de cliente OAuth 2.0 (Aplicación web).
# El CLIENT_ID es público; el CLIENT_SECRET no lo usa este flujo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Google Maps / Places (opcional) ----------
GOOGLE_MAPS_API_KEY=

# Crear/promover un admin:
#   npm run seed:admin -- --cedula <cedula> --password <password>
